          if ((int32)(tag >> 3) == group) { return true; }
          codec_rd_fail(r, CODEC_ERR_INVALID);
          return false;
        }
        if (!codec_pb_keep_unknown(r, tag, start, depth, &m->_unknown)) { return false; }
      }
    }
    if (r->err != CODEC_OK) { return false; }
  }
  if (group != 0) {
    codec_rd_fail(r, CODEC_ERR_TRUNCATED);
    return false;
  }
  return r->err == CODEC_OK;
}

// Merges the message in `data` into m. Strings and bytes in m point into
// `data`, so keep it alive while m is in use. Returns CODEC_OK or an error.
export fn GtHookResponse_decode(m: GtHookResponse*, data: string) -> int32 {
  var r: CodecReader;
  codec_rd_init_string(&r, data);
  if (!GtHookResponse_read(m, &r, CODEC_PB_DEPTH, 0)) {
    if (r.err == CODEC_OK) { return CODEC_ERR_INVALID; }
    return r.err;
  }
  if (!GtHookResponse_check(m)) { return CODEC_ERR_MISSING; }
  return CODEC_OK;
}

// True when every proto2 required field, here and in nested messages, is set.
export fn GtHookResponse_check(m: GtHookResponse*) -> bool {
  return true;
}

// Zeroes m and sets proto2 default values (has_ flags stay false).
export fn GtHookResponse_init(m: GtHookResponse*) {
  mem_zero((cstring)m, sizeof(GtHookResponse));
}

// Frees the memory decoding allocated in m (nested messages and lists).
// Strings point into the decoded input and are not freed.
export fn GtHookResponse_free(m: GtHookResponse*) {
  codec_list_free(&m->_unknown);
}
