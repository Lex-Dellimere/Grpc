// mbuild.mettle: the project file for grpc. `mbuild help` lists its commands.
//
// Layout: src/grpc.mettle is the facade ("grpc/grpc"); modules sit in src/.
// Tests: tests/<name>_test.mettle, run with `mbuild test` and `mbuild test -r`.
import "mbuild/api";

fn project() {
  mb_package("grpc", "0.1.0");
  mb_meta("description", "gRPC clients and servers in pure Mettle");
  mb_meta("license", "Apache-2.0");
  mb_meta("repository", "https://github.com/Lex-Dellimere/grpc");
  mb_import_root("src");
}

fn deps() {
  mb_dep_path("press", "../press");
  mb_dep_path("codec", "../codec");
}

// gen: rebuilds the protobuf code in src/gen from proto/ with Codec's
// compiler (../codec). Types get the GrpcPb prefix.
fn cmd_gen(a: MbArgs*) -> int32 {
  if (mb_sh("cd ../codec && mbuild build codec_protoc") != 0) { return 1; }
  var exe: string = "../codec/build/" + mb_os() + "/debug/codec_protoc";
  return mb_sh(exe + " -I proto --out src/gen --prefix GrpcPb google/rpc/status.proto google/rpc/error_details.proto grpc/health/v1/health.proto grpc/reflection/v1/reflection.proto google/protobuf/descriptor.proto");
}
