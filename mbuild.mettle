// mbuild.mettle: the project file for grpc. `mbuild help` lists its commands.
//
// Layout: src/grpc.mettle is the facade ("grpc/grpc"); modules sit in src/.
// Tests: tests/<name>_test.mettle, run with `mbuild test` and `mbuild test -r`.
import "mbuild/api";

fn project() {
  mb_package("grpc", "0.1.0");
  mb_meta("description", "gRPC clients and servers in pure Mettle");
  mb_meta("license", "Apache-2.0");
  mb_meta("repository", "https://github.com/Lex-Dellimere/Grpc");
  mb_import_root("src");
  mb_bin("grpc_gen", "tools/grpc_gen/main.mettle");
  mb_bin("example_greeter", "examples/greeter/main.mettle");
  mb_bin("interop_server", "tools/interop/server.mettle");
  mb_bin("interop_client", "tools/interop/client.mettle");
  mb_bin("grpc_bench", "bench/bench.mettle");
}

fn deps() {
  mb_dep_path("press", "../press");
  mb_dep_path("codec", "../codec");
  mb_dep_path("mtls", "../mtls");
  mb_dep_path("crypto", "../cryptex");
}

// gen: rebuilds the generated code in src/gen and tests/gen: messages with
// Codec's compiler (../codec), services with grpc_gen. Types in src/gen get
// the GrpcPb prefix.
fn cmd_gen(a: MbArgs*) -> int32 {
  if (mb_sh("cd ../codec && mbuild build codec_protoc") != 0) { return 1; }
  var exe: string = "../codec/build/" + mb_os() + "/debug/codec_protoc";
  if (mb_sh(exe + " -I proto --out src/gen --prefix GrpcPb google/rpc/status.proto google/rpc/error_details.proto google/protobuf/descriptor.proto") != 0) { return 1; }
  // Services go through this library's own generator, which needs the
  // descriptor code above.
  if (mb_mbuild("build grpc_gen") != 0) { return 1; }
  var gen: string = mb_out("grpc_gen", mb_os(), "debug");
  if (mb_sh(gen + " -I proto --out src/gen --prefix GrpcPb grpc/health/v1/health.proto grpc/reflection/v1/reflection.proto") != 0) { return 1; }
  if (mb_sh(gen + " -I examples/greeter --out examples/greeter/gen helloworld.proto") != 0) { return 1; }
  if (mb_sh(gen + " -I tools/interop/proto --out tools/interop/gen --prefix Gt grpc/testing/test.proto") != 0) { return 1; }
  return mb_sh(gen + " -I tests/proto -I proto --out tests/gen --prefix T echo.proto");
}

// bench: builds the loopback benchmark in release and runs it.
fn cmd_bench(a: MbArgs*) -> int32 {
  if (mb_mbuild("build -r grpc_bench") != 0) { return 1; }
  var c: MbCmd* = mb_cmd(mb_out("grpc_bench", mb_os(), "release"));
  return mb_cmd_run(c);
}
