// Message framing, compression and the deframer, including hostile input.
import "grpc/message";
import "grpc/status";
import "press/core/buf";
import "tutil";
import "std/mem";

fn feed_all(d: GrpcDeframer*, p: uint8*, n: int64, step: int64, count: int64*, total: int64*) -> int32 {
  var i: int64 = 0;
  while (i < n) {
    var k: int64 = step;
    if (i + k > n) { k = n - i; }
    grpc_deframer_feed(d, p + i, k);
    i = i + k;
    var m: GrpcMsg;
    while (true) {
      var r: int32 = grpc_deframer_next(d, &m);
      if (r == GRPC_DF_ERROR) { return d->code; }
      if (r == GRPC_DF_MORE) { break; }
      *count = *count + 1;
      for j in 0..m.len { *total = *total + (int64)m.data[j]; }
    }
  }
  return grpc_deframer_finish(d);
}

fn main() -> int32 {
  t_eq("enc gzip", grpc_encoding_parse("gzip"), GRPC_ENC_GZIP);
  t_eq("enc snappy", grpc_encoding_parse("snappy"), -1);
  t_ok("accept gzip", grpc_accept_has("deflate, gzip", GRPC_ENC_GZIP));
  t_ok("accept not", !grpc_accept_has("deflate", GRPC_ENC_GZIP));
  t_ok("accept identity", grpc_accept_has("", GRPC_ENC_IDENTITY));
  t_ok("accept no prefix match", !grpc_accept_has("gzipx", GRPC_ENC_GZIP));

  // A stream of messages of mixed size, plain and compressed.
  var msg: uint8* = (uint8*)malloc(100000);
  for i in 0..100000 { msg[i] = (uint8)((i / 7) % 26 + 97); }
  for e in 0..3 {
    var enc: int32 = (int32)e;
    var out: PressBuf;
    var want_total: int64 = 0;
    var sizes: int64[6] = [0, 1, 5, 1000, 70000, 100000];
    for s in 0..6 {
      t_eq("frame {enc} {s}", grpc_frame(msg, sizes[s], enc, s % 2 == 0, &out), GRPC_OK);
      for j in 0..sizes[s] { want_total = want_total + (int64)msg[j]; }
    }
    if (enc != GRPC_ENC_IDENTITY) {
      // The 100000-byte message compresses well: its flag must be set.
      t_ok("smaller {enc}", out.len < 170000);
    }
    var steps: int64[4] = [1, 3, 4096, 1000000];
    for st in 0..4 {
      var d: GrpcDeframer;
      grpc_deframer_init(&d, 0, enc);
      var count: int64 = 0;
      var total: int64 = 0;
      t_eq("deframe {enc} {st}", feed_all(&d, out.data, out.len, steps[st], &count, &total), GRPC_OK);
      t_eq("count {enc} {st}", count, 6);
      t_eq("total {enc} {st}", total, want_total);
      grpc_deframer_free(&d);
    }
    press_buf_free(&out);
  }

  // Limits: plain over max, and a compressed bomb over max.
  var big: PressBuf;
  grpc_frame(msg, 100000, GRPC_ENC_IDENTITY, false, &big);
  var d1: GrpcDeframer;
  grpc_deframer_init(&d1, 50000, GRPC_ENC_IDENTITY);
  var c1: int64 = 0;
  var t1: int64 = 0;
  t_eq("plain over max", feed_all(&d1, big.data, 10, 10, &c1, &t1), GRPC_RESOURCE_EXHAUSTED);
  grpc_deframer_free(&d1);
  press_buf_free(&big);
  var zeros: uint8* = (uint8*)calloc(1, 10000000);
  var bomb: PressBuf;
  grpc_frame(zeros, 10000000, GRPC_ENC_GZIP, true, &bomb);
  t_ok("bomb small", bomb.len < 100000);
  var d2: GrpcDeframer;
  grpc_deframer_init(&d2, 0, GRPC_ENC_GZIP);
  t_eq("bomb refused", feed_all(&d2, bomb.data, bomb.len, 65536, &c1, &t1), GRPC_RESOURCE_EXHAUSTED);
  grpc_deframer_free(&d2);
  // Compressed flag on an identity stream.
  var d3: GrpcDeframer;
  grpc_deframer_init(&d3, 0, GRPC_ENC_IDENTITY);
  t_eq("flag without encoding", feed_all(&d3, bomb.data, bomb.len, 65536, &c1, &t1), GRPC_INTERNAL);
  grpc_deframer_free(&d3);
  press_buf_free(&bomb);
  free(zeros);

  // Truncated stream, bad flag byte.
  var bad: uint8[7] = [0, 0, 0, 0, 5, 1, 2];
  var d4: GrpcDeframer;
  grpc_deframer_init(&d4, 0, GRPC_ENC_IDENTITY);
  t_eq("truncated", feed_all(&d4, &bad[0], 7, 7, &c1, &t1), GRPC_INTERNAL);
  grpc_deframer_free(&d4);
  bad[0] = 2;
  var d5: GrpcDeframer;
  grpc_deframer_init(&d5, 0, GRPC_ENC_IDENTITY);
  t_eq("bad flag", feed_all(&d5, &bad[0], 7, 7, &c1, &t1), GRPC_INTERNAL);
  grpc_deframer_free(&d5);

  // Fuzz: random bytes, random encodings and steps; must never crash.
  t_seed(42);
  var junk: uint8* = (uint8*)malloc(4096);
  for round in 0..3000 {
    var n: int64 = (int64)(t_rand() % 4096);
    for j in 0..n { junk[j] = (uint8)(t_rand() & 255); }
    // Make some prefixes plausible so the inflaters get exercised.
    if (n > 5 && round % 2 == 0) {
      junk[0] = 1;
      junk[1] = 0;
      junk[2] = 0;
      junk[3] = (uint8)(((n - 5) >> 8) & 255);
      junk[4] = (uint8)((n - 5) & 255);
      if (round % 4 == 0) { junk[5] = 31; junk[6] = 139; junk[7] = 8; }
    }
    var df: GrpcDeframer;
    grpc_deframer_init(&df, 0, (int32)(round % 3));
    feed_all(&df, junk, n, (int64)(t_rand() % 300) + 1, &c1, &t1);
    grpc_deframer_free(&df);
  }
  t_ok("fuzz survived", true);
  free(junk);
  free(msg);
  return t_done("message");
}
